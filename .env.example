# Configuração local para `docker compose up --build`
POSTGRES_DB=olivaras
POSTGRES_USER=olivaras
POSTGRES_PASSWORD=olivaras_local
POSTGRES_PORT=5432

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
JWT_SECRET=troque-por-uma-chave-local-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MINUTES=30

# Configure no Google Cloud Console; o client ID também será usado pelo Angular.
GOOGLE_AUTH_ENABLED=false #MUDE AQUI PARA VERDADEIRO APENAS SE FOR UTILIZAR O SERVICO DO GOOGLE AUTH EM AMBIENTE LOCAL, 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EXCHANGE_BRL_PER_GALLEON=5.00

ZIP_CODE_PROVIDER=viacep
